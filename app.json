{
  "expo": {
    "name": "구데기",
    "slug": "gudegi-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gudegi-mascot-icon.png",
    "scheme": "gudegi",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/gudegi-mascot-icon.png",
      "bundleIdentifier": "com.iftype.gudegi",
      "supportsTablet": false,
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "방송 시작, 방제 변경, 카테고리 및 키워드 알림을 보내기 위해 사용합니다."
      }
    },
    "android": {
      "package": "com.iftype.gudegi",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/gudegi-mascot-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/gudegi-mascot-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141517",
          "image": "./assets/images/gudegi-mascot.png",
          "imageWidth": 76
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c4d2317a-6677-4302-b7b9-000f6d59df08"
      }
    },
    "owner": "iftype"
  }
}
